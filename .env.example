# Copy to .env and fill in. Never commit .env.

# Any provider supported by LangChain's init_chat_model. Other providers need
# their package installed (e.g. pip install langchain-openai) and their own key.
#
# Gemini (Google AI Studio key; needs langchain-google-genai, already in requirements.txt):
#   LLM_PROVIDER=google_genai
#   LLM_MODEL=gemini-3.6-flash
#   GOOGLE_API_KEY=...
# Claude:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-opus-5-5
#   ANTHROPIC_API_KEY=...
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.6-flash
LLM_MAX_TOKENS=8000
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Connect as the read-only role created by data/roles.sql
DATABASE_URL=postgresql://sql_agent_ro:YOUR_PASSWORD@localhost:5432/retail

MAX_ROWS=200
STATEMENT_TIMEOUT_MS=5000
MAX_ATTEMPTS=3
